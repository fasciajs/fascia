{
  "name": "fascia-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace root. Publishes nothing. Every package lives under packages/.",
  "license": "MIT",
  "author": "Joshua Hernandez <josher8a@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/fasciajs/fascia"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check:types && npm run check:lint && npm run check:unit",
    "check:types": "tsc -p tsconfig.json",
    "check:lint": "biome check .",
    "check:unit": "vitest run",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@ark/attest": "^0.56.3",
    "@ark/schema": "^0.56.2",
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.13.3",
    "arktype": "^2.2.3",
    "effect": "^3.22.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
