{
  "name": "fascia-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace root. Publishes nothing. Every package lives under packages/.",
  "license": "MIT",
  "author": "Joshua Hernandez <josher8a@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/fasciajs/fascia"
  },
  "workspaces": [
    "packages/*",
    "internal/*"
  ],
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "check": "npm run check:types && npm run check:lint && npm run check:unit",
    "check:types": "tsc -p tsconfig.json",
    "check:lint": "biome check .",
    "check:unit": "vitest run",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@ark/attest": "^0.56.3",
    "@ark/schema": "^0.56.2",
    "@arrirpc/codegen-dart": "^0.84.1",
    "@arrirpc/codegen-rust": "^0.84.1",
    "@arrirpc/codegen-ts": "^0.84.1",
    "@arrirpc/schema": "^0.84.1",
    "@biomejs/biome": "^2.5.6",
    "@seriousme/openapi-schema-validator": "^2.9.1",
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "arktype": "^2.2.3",
    "effect": "^3.22.1",
    "json-schema-typed": "^8.0.2",
    "openapi-types": "^12.1.3",
    "rolldown": "^1.2.3",
    "rolldown-plugin-dts": "^0.28.0",
    "typescript": "^5.9.3",
    "valibot": "^1.1.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
