{
  "name": "@fasciajs/openapi",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "A set of operations, written as an OpenAPI 3.1 document.",
  "license": "MIT",
  "author": "Joshua Hernandez <josher8a@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fasciajs/fascia.git",
    "directory": "packages/openapi"
  },
  "exports": {
    ".": {
      "fascia-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fasciajs/core": "0.1.0",
    "@fasciajs/json-schema": "0.1.0"
  },
  "peerDependencies": {
    "openapi-types": "^12.0.0"
  }
}
